+
+  - name: affinescript-dom-package-is-mpl
+    description: "affinescript-dom/package.json must declare license MPL-2.0."
+    run: "bash -uc 'grep -q \"\\\"license\\\": \\\"MPL-2.0\\\"\" affinescript-dom/package.json'"
+
+  - name: affinescript-dom-docs-are-cc-by-sa
+    description: "affinescript-dom documentation (README.adoc) must declare SPDX CC-BY-SA-4.0."
+    run: "bash -uc 'grep -q \"SPDX-License-Identifier: CC-BY-SA-4.0\" affinescript-dom/README.adoc'"
+
+  - name: licenses-folder-has-both
+    description: "LICENSES/ must contain both MPL-2.0 (code) and CC-BY-SA-4.0 (docs) texts."
+    run: "bash -uc 'test -f LICENSES/LICENSE-MPL-2.0 && test -f LICENSES/LICENSE-CC-BY-SA-4.0'"
