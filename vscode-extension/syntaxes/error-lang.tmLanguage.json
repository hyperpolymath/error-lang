{
  "name": "Error-Lang",
  "scopeName": "source.error-lang",
  "fileTypes": ["err"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.error-lang",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.error-lang",
          "match": "\\b(main|end|if|elseif|else|while|for|in|break|continue|return|function|fn)\\b"
        },
        {
          "name": "keyword.declaration.error-lang",
          "match": "\\b(let|mutable|struct)\\b"
        },
        {
          "name": "keyword.operator.logical.error-lang",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.error-lang",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "storage.type.error-lang",
          "match": "\\b(int|float|string|bool|array)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.error-lang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.error-lang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.error-lang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.error-lang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.positional.error-lang",
          "match": "[+*]",
          "comment": "Positional operators - behavior changes by column!"
        },
        {
          "name": "keyword.operator.arithmetic.error-lang",
          "match": "[-/%]"
        },
        {
          "name": "keyword.operator.comparison.error-lang",
          "match": "(==|!=|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.assignment.error-lang",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.error-lang",
          "match": "\\b(println|print|stability|trace|checkpoint|assert_invariant)\\b"
        }
      ]
    }
  }
}
