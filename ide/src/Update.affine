// ── update ─────────────────────────────────────────────────────────────────
// Consumes a Msg and the old Model; produces (new Model, Cmd).

pub fn update(msg: Msg, model: Model) -> (Model, Cmd) {
  match msg {
    // Code editing — trigger background compilation.
    CodeChanged(new_code) => (with_code(model, new_code), MsgCmd(CompileCode)),

    CursorMoved(pos) => (with_cursor(model, pos), NoCmd),

    // Monaco editor events
    MonacoReady => (with_monaco_ready(model, true), NoCmd),

    MonacoContentChanged(new_code) => (with_code(model, new_code), MsgCmd(CompileCode)),

    MonacoCursorMoved(line, col) => (with_cursor(model, #{ line: line, column: col }), NoCmd),

    // Compilation — simulate (real compiler call in full implementation).
    CompileCode => (model, MsgCmd(CompilationSuccess("AST placeholder"))),

    // On success: store AST, clear errors, then trigger stability analysis.
    CompilationSuccess(ast) => (with_compilation_success(model, ast), MsgCmd(AnalyzeStability)),

    CompilationFailure(errors) => (with_compilation_failure(model, errors), NoCmd),

    // Layer navigation
    NavigateToLayer(layer) => (with_layer(model, layer), NoCmd),

    // Stability analysis — simulate.
    AnalyzeStability => (model, MsgCmd(StabilityAnalyzed(95, ["mutable-state"]))),

    StabilityAnalyzed(score, factors) => (with_stability_analyzed(model, score, factors), NoCmd),

    // Five Whys analysis — simulate.
    RunFiveWhys(factor) => (model, MsgCmd(FiveWhysComplete("Analysis result..."))),

    FiveWhysComplete(result) => (with_five_whys(model, result), NoCmd),

    // Execution
    RunProgram => (with_run_started(model), NoCmd),

    RuntimeOutput(output) => (with_runtime_output(model, output), NoCmd),

    ExecutionComplete(final_score) => (with_execution_complete(model, final_score), NoCmd),

    // UI
    SwitchPanel(panel) => (with_panel(model, panel), NoCmd),

    ChangeTheme(theme) => (with_theme(model, theme), NoCmd),

    ToggleSidebar => (with_sidebar(model, not(model.sidebarVisible)), NoCmd),

    // Router integration
    RouteChanged(path) => handle_route(path, model),

    // Router handles this; no state change.
    NavigateTo(path) => (model, NoCmd),

    // catch-all (mirrors `| _ => (model, Tea.Cmd.none)`)
    _ => (model, NoCmd)
  }
}

// ── handleRoute ──────────────────────────────────────────────────────────
// Parse "/explore/<layer>" and re-enter `update(NavigateToLayer(layer))`.

pub fn handle_route(path: String, model: Model) -> (Model, Cmd) {
  if starts_with(path, "/explore/") {
    let layer_name = substring(path, 9, len(path));
    let layer = if layer_name == "grammar" { Grammar }
      else if layer_name == "parser" { Parser }
      else if layer_name == "ast" { AST }
      else if layer_name == "semantics" { Semantics }
      else if layer_name == "runtime" { Runtime }
      else { AST };
    update(NavigateToLayer(layer), model)
  } else {
    (model, NoCmd)
  }
}
