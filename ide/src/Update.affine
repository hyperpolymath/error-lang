// StabilityAnalyzed: score, factors, history += [score]
pub fn with_stability_analyzed(m: Model, score: Int, factors: [String]) -> Model {
  #{
    code: m.code,
    fileName: m.fileName,
    cursorPosition: m.cursorPosition,
    selection: m.selection,
    ast: m.ast,
    parseErrors: m.parseErrors,
    stabilityScore: score,
    stabilityHistory: m.stabilityHistory ++ [score],
    stabilityFactors: factors,
    currentLayer: m.currentLayer,
    layerViews: m.layerViews,
    fiveWhysResult: m.fiveWhysResult,
    paradoxes: m.paradoxes,
    quantumVariables: m.quantumVariables,
    activePanel: m.activePanel,
    theme: m.theme,
    fontSize: m.fontSize,
    sidebarVisible: m.sidebarVisible,
    isRunning: m.isRunning,
    runtimeOutput: m.runtimeOutput,
    runNumber: m.runNumber,
    monacoReady: m.monacoReady
  }
}

