// SPDX-License-Identifier: MPL-2.0
// Update.affine — state transitions for the Error-Lang Studio IDE.
// Ported from ide/src/Update.res (ReScript-TEA → AffineScript).
//
// ── Port conventions ──────────────────────────────────────────────────────
//   * `open Model` + `open Msg` -> `use Model::*;` + `use Msg::*;`.
//   * `type cmd = Tea.Cmd.t<msg>` -> a local `pub enum Cmd { NoCmd, MsgCmd(Msg) }`
//       Tea.Cmd.none      -> NoCmd
//       Tea.Cmd.msg(m)    -> MsgCmd(m)
//     (TEA effects in this IDE are only "no effect" or "dispatch another msg".)
//   * `update : (msg, model) -> (model, cmd)` -> `update(msg, model) -> (Model, Cmd)`.
//   * NO record-spread `{...model, x: v}` (parse error in AffineScript) and NO
//     mutable struct fields → every transition rebuilds the whole Model record.
//     To keep that faithful and DRY, single-field rebuilds go through
//     `with_*` helpers below (each constructs a full record changing one/two
//     fields; all other fields copied across unchanged).
//   * `Array.concat(xs, [y])` -> `xs ++ [y]`.
//   * `String.startsWith` -> `string::starts_with`;
//     `String.sliceToEnd(path, ~start=9)` -> `string::substring(path, 9, len(path))`.
//   * `update` and `handleRoute` are ReScript `and`-recursive; in AffineScript
//     top-level `fn`s are mutually visible, so they call each other directly.
//
// ── Faithfulness notes ────────────────────────────────────────────────────
//   * Same message→transition mapping as Update.res, including the chained
//     commands (CodeChanged/MonacoContentChanged -> CompileCode; CompileCode ->
//     CompilationSuccess; CompilationSuccess -> AnalyzeStability; AnalyzeStability
//     -> StabilityAnalyzed; RunFiveWhys -> FiveWhysComplete) with the same
//     simulated payloads ("AST placeholder", score 95, factor "mutable-state",
//     "Analysis result...").
//   * The `| _ => (model, Tea.Cmd.none)` catch-all is preserved as a `_` arm.
//   * `handleRoute` parses "/explore/<layer>" exactly as the .res (same layer
//     name mapping, same `AST` default) and re-enters `update(NavigateToLayer)`.

module Update;

use prelude::*;
use string::{starts_with, substring};
use Model::*;
use Msg::*;

// TEA command: either no effect, or dispatch another message.
pub enum Cmd {
  NoCmd,
  MsgCmd(Msg)
}

// ── whole-record rebuild helpers (stand-ins for `{...model, field: v}`) ─────

pub fn with_code(m: Model, code: String) -> Model {
  #{
    code: code,
    fileName: m.fileName,
    cursorPosition: m.cursorPosition,
    selection: m.selection,
    ast: m.ast,
    parseErrors: m.parseErrors,
    stabilityScore: m.stabilityScore,
    stabilityHistory: m.stabilityHistory,
    stabilityFactors: m.stabilityFactors,
    currentLayer: m.currentLayer,
    layerViews: m.layerViews,
    fiveWhysResult: m.fiveWhysResult,
    paradoxes: m.paradoxes,
    quantumVariables: m.quantumVariables,
    activePanel: m.activePanel,
    theme: m.theme,
    fontSize: m.fontSize,
    sidebarVisible: m.sidebarVisible,
    isRunning: m.isRunning,
    runtimeOutput: m.runtimeOutput,
    runNumber: m.runNumber,
    monacoReady: m.monacoReady
  }
}

